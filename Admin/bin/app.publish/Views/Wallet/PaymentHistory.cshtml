@model  Wallet_Model
@{
    ViewBag.Title = "Payment History";
    var filePath = "http://admin.freshfoodz.in.net/Content/OrderSummary/";
}
<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-lg-10">
        <h2>Reports</h2>
        <ol class="breadcrumb">
            <li>
                <a href="@Url.Action("Index", "Home")">Dashboard</a>
            </li>
            <li>
                <a href="@Url.Action("AddMoney", "Wallet")">Wallet Summary</a>
            </li>
            <li class="active">
                <strong>Wallet History</strong>
            </li>
        </ol>
    </div>
    <div class="col-lg-2">
    </div>
</div>
<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-content">
                    <div class="form-group row">
                        <div class="col-md-12">
                            <ul class="sortable-list connectList agile-list">
                                <li class="success-element" style="font-size: 15px;text-transform: uppercase;">
                                    <label>Customer Name: @Model.UserName</label>
                                    @if (Model.WalletBalance > 0)
                                    {
                                        <label class="pull-right">Wallet Balance: <i class="fa fa-inr" aria-hidden="true"></i>&nbsp;<span style="color:green">@Model.WalletBalance</span></label>
                                    }
                                    else
                                    {
                                        <label class="pull-right">Wallet Balance: <i class="fa fa-inr" aria-hidden="true"></i>&nbsp;<span style="color:red">@Model.WalletBalance</span> </label>
                                    }
                                </li>
                            </ul>
                            <table class="table table-striped table-bordered table-hover dataTables-example">
                                <tbody>
                                    @if (Model._walletHistory != null)
                                    {
                                        foreach (var item in Model._walletHistory)
                                        {
                                            <tr>
                                                @if (item.Type == "Debit")
                                                {
                                                    <td style="text-align: left;">
                                                        <div class="col-md-12" style="color: red;">
                                                            <span><b>Order No : @item.OrderNo</b></span><br />
                                                            <span><b>Debit Amount : <i class="fa fa-inr" aria-hidden="true"></i>&nbsp;<span>@item.Amount</span></b></span><br />
                                                            <span><b>Payment Date : @item.EntryDate.ToString().Substring(0, item.EntryDate.ToString().Length - 11)</b></span><br />
                                                            <span><b><a title="View Invoice" style="color: #337ab7;" href="@Url.Content(filePath+item.Invoice)" target="_blank"><i class="fa fa-file"></i>&nbsp; View Invoice</a></b></span>
                                                        </div>
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td style="text-align: right;">
                                                        <div class="col-md-12" style="color: green;">
                                                            <span><b>Credit Amount : <i class="fa fa-inr" aria-hidden="true"></i>&nbsp;<span>@item.Amount</span></b></span><br />
                                                            <span><b>Payment Date : @item.EntryDate.ToString().Substring(0, item.EntryDate.ToString().Length - 11)</b></span><br />
                                                            <span><b>Payment Mode : @item.PaymentMode</b></span>
                                                        </div>
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <hr />
                </div>
            </div>
        </div>
    </div>
</div>
@section Styles {
    @Styles.Render("~/plugins/sweetAlertStyles")
    @Styles.Render("~/plugins/dateRangeStyles")
    @Styles.Render("~/plugins/dataPickerStyles")
    @Styles.Render("~/Content/plugins/iCheck/iCheckStyles")
    @Styles.Render("~/plugins/awesomeCheckboxStyles")
    @Styles.Render("~/plugins/select2Styles")
    @Styles.Render("~/plugins/footableStyles")
    @Styles.Render("~/Content/plugins/dataTables/dataTablesStyles")
}
@section Scripts{
    @Scripts.Render("~/plugins/sweetAlert")
    @Scripts.Render("~/plugins/dateRange")
    @Scripts.Render("~/plugins/dataPicker")
    @Scripts.Render("~/plugins/iCheck")
    @Scripts.Render("~/plugins/select2")
    @Scripts.Render("~/plugins/validate")
    @Scripts.Render("~/plugins/footable")
    @Scripts.Render("~/plugins/dataTables")

    <script type="text/javascript">
        $(document).ready(function () {

            if ($("#Amount").val() == 0) {
                $("#Amount").val("");
            }

            $(".select2_demo_1").select2();

            if ('@TempData["SuccessMessage"]' != '') {
                sweetAlert("Sucesss!!", '@TempData["SuccessMessage"]', "success");
            }
            if ('@TempData["ErrorMessage"]' != '') {
                sweetAlert("Error!!", '@TempData["ErrorMessage"]', "error");
            }

            $('.dataTables-example').DataTable({
                pageLength: 25,
                dom: '<"html5buttons"B>lTfgitp',
                buttons: [
                    { extend: 'copy' },
                    { extend: 'csv' },
                    { extend: 'excel', title: 'ExampleFile' },
                    { extend: 'pdf', title: 'ExampleFile' },
                    {
                        extend: 'print',
                        customize: function (win) {
                            $(win.document.body).addClass('white-bg');
                            $(win.document.body).css('font-size', '10px');

                            $(win.document.body).find('table')
                                .addClass('compact')
                                .css('font-size', 'inherit');
                        }
                    }
                ]
            });
    </script>
}