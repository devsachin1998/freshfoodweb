@{
    ViewBag.Title = "Wallet Detail";
}

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-lg-10">
        <h2>Wallet Detail</h2>

        <ol class="breadcrumb">
            <li>
                <a href="@Url.Action("Index", "Home")">Dashboard</a>
            </li>

            <li class="active">
                <strong>Wallet Detail</strong>
            </li>
        </ol>
    </div>
</div>

<div class="wrapper wrapper-content animated fadeInRight">

    <div class="row">
        <div class="col-lg-12">

            <div class="ibox float-e-margins">

                <div class="ibox-title">
                    <h5>Wallet Details</h5>
                </div>

                <div class="ibox-content">

                    <!-- Loading -->
                    <div id="walletLoading"
                         class="text-center"
                         style="padding:20px;">

                        <i class="fa fa-spinner fa-spin"></i>
                        Loading wallet details...

                    </div>

                    <!-- Error -->
                    <div id="walletError"
                         class="text-center text-danger"
                         style="padding:20px; display:none;">
                    </div>

                    <!-- Table -->
                    <div class="table-responsive">

                        <table id="walletDetailTable"
                               class="table table-striped table-bordered table-hover"
                               style="width:100%; display:none;">

                            <thead>
                                <tr>
                                    <th>Customer Id</th>
                                    <th>Customer Name</th>
                                    <th>Address</th>
                                    <th>Mobile No</th>
                                    <th class="text-right">
                                        Wallet Balance
                                    </th>
                                    <th class="text-center">
                                        History
                                    </th>
                                </tr>
                            </thead>

                            <tbody id="walletDetailBody">
                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>
    </div>

</div>


@section Styles
{
    @Styles.Render("~/Content/plugins/dataTables/dataTablesStyles")
}


@section Scripts
{
    @Scripts.Render("~/plugins/dataTables")

    <script type="text/javascript">

        $(document).ready(function () {

            var $table = $('#walletDetailTable');
            var $tbody = $('#walletDetailBody');
            var $loading = $('#walletLoading');
            var $error = $('#walletError');


            // ---------------------------------------------------------
            // Escape HTML
            // ---------------------------------------------------------

            function escapeHtml(value) {

                return $('<div/>')
                    .text(value == null ? '' : value)
                    .html();
            }


            // ---------------------------------------------------------
            // Format money
            // ---------------------------------------------------------

            function money(value) {

                var amount = parseFloat(value || 0);

                return amount.toFixed(2);
            }


            // ---------------------------------------------------------
            // Show error
            // ---------------------------------------------------------

            function showError(message) {

                $loading.hide();

                $error
                    .text(
                        message ||
                        'Unable to load wallet details.'
                    )
                    .show();
            }


            // ---------------------------------------------------------
            // Load Wallet Details
            // ---------------------------------------------------------

            function loadWalletDetails() {

                $loading.show();
                $error.hide();
                $table.hide();


                $.ajax({

                    url: '@Url.Action("GetWalletDetails", "Wallet")',

                    type: 'GET',

                    dataType: 'json',

                    // Browser can cache this request.
                    cache: true,


                    success: function (response) {


                        // -------------------------------------------------
                        // API Error
                        // -------------------------------------------------

                        if (!response ||
                            response.success !== true) {

                            showError(
                                response &&
                                response.message
                                    ? response.message
                                    : 'Unable to load wallet details.'
                            );

                            return;
                        }


                        var rows = response.data || [];


                        // -------------------------------------------------
                        // No Data
                        // -------------------------------------------------

                        if (rows.length === 0) {

                            $tbody.html(
                                '<tr>' +
                                    '<td colspan="6" ' +
                                        'class="text-center text-muted">' +
                                        'No wallet details found.' +
                                    '</td>' +
                                '</tr>'
                            );

                            $loading.hide();

                            $table.show();

                            return;
                        }


                        // -------------------------------------------------
                        // IMPORTANT PERFORMANCE OPTIMIZATION
                        //
                        // Don't call $tbody.append() inside the loop.
                        // Build complete HTML first and insert once.
                        // -------------------------------------------------

                        var html = '';


                        for (var i = 0; i < rows.length; i++) {

                            var item = rows[i];

                            var balance =
                                parseFloat(
                                    item.Balance || 0
                                );


                            // Backend already filters zero balance.
                            // This is an additional safety check.

                            if (balance === 0) {
                                continue;
                            }


                            // -------------------------------------------------
                            // Balance color
                            // -------------------------------------------------

                            var balanceStyle =
                                balance > 0
                                    ? 'color:green;font-weight:bold;'
                                    : 'color:red;font-weight:bold;';


                            // -------------------------------------------------
                            // History URL
                            // -------------------------------------------------

                            var historyUrl =
                                '@Url.Action("PaymentHistory", "Wallet")' +
                                '?UserID=' +
                                encodeURIComponent(
                                    item.UserID
                                );


                            // -------------------------------------------------
                            // Build row
                            // -------------------------------------------------

                            html +=

                                '<tr>' +

                                    '<td>' +
                                        '<b>' +
                                            escapeHtml(
                                                item.UserID
                                            ) +
                                        '</b>' +
                                    '</td>' +


                                    '<td>' +
                                        escapeHtml(
                                            item.UserName
                                        ) +
                                    '</td>' +


                                    '<td>' +
                                        escapeHtml(
                                            item.Address
                                        ) +
                                    '</td>' +


                                    '<td>' +
                                        escapeHtml(
                                            item.Mobile
                                        ) +
                                    '</td>' +


                                    '<td class="text-right">' +

                                        '<i class="fa fa-inr"></i>&nbsp;' +

                                        '<span style="' +
                                            balanceStyle +
                                        '">' +

                                            money(balance) +

                                        '</span>' +

                                    '</td>' +


                                    '<td class="text-center">' +

                                        '<a ' +
                                            'title="View History" ' +
                                            'class="btn btn-xs btn-primary" ' +
                                            'href="' +
                                                historyUrl +
                                            '">' +

                                            '<i class="fa fa-history"></i> ' +
                                            'View History' +

                                        '</a>' +

                                    '</td>' +

                                '</tr>';
                        }


                        // -------------------------------------------------
                        // ONE DOM UPDATE
                        // -------------------------------------------------

                        $tbody.html(html);


                        // -------------------------------------------------
                        // Show table
                        // -------------------------------------------------

                        $loading.hide();

                        $table.show();


                        // -------------------------------------------------
                        // DataTables
                        // -------------------------------------------------

                        $table.DataTable({

                            pageLength: 25,

                            deferRender: true,

                            /*
                             * Removed processing:true because our own
                             * loader is already handling loading state.
                             */
                            processing: false,

                            order: [
                                [1, 'asc']
                            ],

                            dom:
                                '<"html5buttons"B>lTfgitp',


                            buttons: [

                                {
                                    extend: 'copy'
                                },

                                {
                                    extend: 'csv',
                                    title: 'Wallet Details'
                                },

                                {
                                    extend: 'excel',
                                    title: 'Wallet Details'
                                },

                                {
                                    extend: 'pdf',
                                    title: 'Wallet Details'
                                },

                                {
                                    extend: 'print',

                                    customize: function (win) {

                                        $(win.document.body)
                                            .css(
                                                'font-size',
                                                '10px'
                                            );


                                        $(win.document.body)
                                            .find('table')
                                            .addClass('compact')
                                            .css(
                                                'font-size',
                                                'inherit'
                                            );
                                    }
                                }
                            ]

                        });

                    },


                    // -------------------------------------------------
                    // AJAX Error
                    // -------------------------------------------------

                    error: function (xhr) {

                        console.log(
                            'GetWalletDetails Error:',
                            xhr.responseText
                        );


                        showError(
                            'Unable to load wallet details.'
                        );
                    }

                });
            }


            // ---------------------------------------------------------
            // Load once when page opens
            // ---------------------------------------------------------

            loadWalletDetails();

        });

    </script>
}