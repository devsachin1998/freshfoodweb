@{
    ViewBag.Title = "User List";
    int count = 1;
}

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-lg-10">
        <h2>Manage User</h2>
        <ol class="breadcrumb">
            <li>
                <a href="@Url.Action("Index", "Home")">Dashboard</a>
            </li>
            <li class="active">
                <strong>User Master</strong>
            </li>
        </ol>
    </div>
    <div class="col-lg-2">
    </div>
</div>
<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>User List</h5>
                    <div class="ibox-tools">
                        <a title="Add New Item" href="@Url.Action("UserDetail","Account")" class="btn btn-primary">
                            <i class="fa fa-plus" aria-hidden="true"></i>&nbsp; Add New User
                        </a>
                    </div>

                </div>
                <div class="ibox-content">
                    <table class="table table-striped table-bordered table-hover dataTables-example">
                        <thead>
                            <tr>
                                <th width="5%">Sr.No</th>
                                <th>Name</th>
                                <th>Mobile No</th>
                                <th>Email</th>
                                <th>User Name</th>
                                <th>Created Date</th>
                                <th class="text-center" width="15%">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Count != 0)
                            {
                                foreach (var item in Model)
                                {
                                    <tr class="gradeX">
                                        <td>@count</td>
                                        <td>@item.Name</td>
                                        <td>@item.MobileNo</td>
                                        <td>@item.Email</td>
                                        <td>@item.UserName</td>
                                        <td>@item.CreatedDate</td>
                                        <td class="text-center">
                                            <div>
                                                <span class="label label-primary" style="font-size:12px;">
                                                    <a title="Edit Details" style="color: #ffffff;" href="@Url.Action("UserDetail","Account",new { UserID = item.UserID })">
                                                        <i class="fa fa-pencil"></i>&nbsp; Edit
                                                    </a>
                                                </span>
                                                <span>&nbsp;&nbsp;</span>
                                                <span class="label label-danger" style="font-size:12px;">
                                                    <a title="Delete User" style="color: #ffffff;" href="#" onclick="fnDeleteUser(@item.UserID)">
                                                        <i class="fa fa-trash"></i>&nbsp; Delete
                                                    </a>
                                                </span>
                                            </div>
                                        </td>
                                    </tr>
                                    count++;
                                }
                            }
                        </tbody>
                        <tfoot>
                        </tfoot>
                    </table>

                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    @Styles.Render("~/plugins/sweetAlertStyles")
    @Styles.Render("~/Content/plugins/dataTables/dataTablesStyles")
}
@section Scripts{
    @Scripts.Render("~/plugins/dataTables")
    @Scripts.Render("~/plugins/validate")
    @Scripts.Render("~/plugins/sweetAlert")

    <script type="text/javascript">
        $(document).ready(function () {

            $("#Countryerror").hide();

            if ('@TempData["SuccessMessage"]' != '') {
                sweetAlert("Sucesss!!", '@TempData["SuccessMessage"]', "success");
            }
            if ('@TempData["ErrorMessage"]' != '') {
                sweetAlert("Error!!", '@TempData["ErrorMessage"]', "error");
            }

            $('.dataTables-example').DataTable({
                pageLength: 25,
                dom: '<"html5buttons"B>lTfgitp',
                buttons: [
                    { extend: 'copy' },
                    { extend: 'csv' },
                    { extend: 'excel', title: 'ExampleFile' },
                    { extend: 'pdf', title: 'ExampleFile' },
                    {
                        extend: 'print',
                        customize: function (win) {
                            $(win.document.body).addClass('white-bg');
                            $(win.document.body).css('font-size', '10px');

                            $(win.document.body).find('table')
                                .addClass('compact')
                                .css('font-size', 'inherit');
                        }
                    }
                ]
            });




        });

        function fnDeleteUser(UserID) {
            swal({
                title: "Are you sure?",
                text: "You want to delete this user?",
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#DD6B55",
                closeOnConfirm: false
            }, function (e) {
                if (e) {
                    $.ajax(
                        {
                            type: "GET",
                            url: '@Url.Action("DeleteName", "Account")',
                            contentType: 'application/json; charset=utf-8',
                            data: { UserID: UserID },
                            dataType: "JSON",
                            success: function (data) {
                                swal(data);
                                window.setTimeout(function () {
                                    location.reload();
                                }, 1000);
                            },
                            error: function (event, xhr, options, exc) {
                                sweetAlert("Error!!", data, "error");
                            }
                        });
                }
            });
        }
    </script>
}