@model Dashboard_Model
@{
    ViewBag.Title = "Dashboard";
    var filePath = "http://admin.freshfoodz.in.net/Content/OrderSummary/";
}

<style>
    .text-info {
        color: #619606;
    }
</style>
<div class="wrapper wrapper-content">
    <div class="row">
        <div class="col-lg-3">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <span class="label label-success pull-right">Today</span>
                    <h5>Orders</h5>
                </div>
                <div class="ibox-content">
                    <h1 class="no-margins">@Model.OrderCount</h1>
                    <div class="stat-percent font-bold text-info"><i class="fa fa-shopping-cart" aria-hidden="true" style="font-size:xx-large;margin-top: -30px;"></i></div>
                    <small>Total Order</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3">
            <div class="ibox float-e-margins">

                <div class="ibox float-e-margins">
                    <div class="ibox-title">
                        <span class="label label-info pull-right">Today</span>
                        <h5>Transaction Detail</h5>
                    </div>
                    <div class="ibox-content">
                        <h1 class="no-margins">@Model.Offlineamount</h1>
                        <div class="stat-percent font-bold text-info" style="margin-top: -30px; margin-right:40px">

                            <h1 class="no-margins">@Model.Online</h1>
                            <small style=" margin-left:5px;">Offline</small>
                        </div>
                        <small>Online</small>
                    </div>
                </div>


            </div>
        </div>
        @*<div class="col-lg-3">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <span class="label label-info pull-right">Available</span>
                    <h5>Items</h5>
                </div>
                <div class="ibox-content">
                    <h1 class="no-margins">@Model.ItemCount</h1>
                    <div class="stat-percent font-bold text-info"><i class="fa fa fa-cubes" aria-hidden="true" style="font-size:xx-large;margin-top: -30px;"></i></div>
                    <small>Item Stock</small>
                </div>
            </div>
        </div>*@
        <div class="col-lg-3">
            <div class="ibox float-e-margins">
                <div class="ibox-title">

                    <h5>Today's Customer</h5>
                    <span class="label label-danger pull-right"> <h5 class="no-margins">@Model.Newcustomer</h5></span>


                </div>
                <div class="ibox-content">
                    <h1 class="no-margins">@Model.UserCount</h1>
                    <div class="stat-percent font-bold text-info"><i class="fa fa fa-users" aria-hidden="true" style="font-size:xx-large;margin-top: -30px;"></i></div>
                    <small>Register Customer</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    @*<span class="label label-danger pull-right">Current</span>*@
                    <span class="label label-success pull-right">Today</span>
                    <h5>Delivered Order</h5>
                </div>
                <div class="ibox-content">
                    <h1 class="no-margins">@Model.DeliveredOrederd</h1>
                    <div class="stat-percent font-bold text-info"><i class="fa fa-truck" aria-hidden="true" style="font-size:xx-large;margin-top: -30px;"></i></div>
                    <small>Delivered Order</small>
                </div>
            </div>
        </div>

    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>Today's Order Summary &nbsp;     <i class="fa fa-inr" aria-hidden="true"></i>  @Model.Orderamount</h5>


                    <div class="ibox-tools">

                        <a class="collapse-link">


                            <i class="fa fa-chevron-up"></i>

                        </a>
                    </div>

                </div>
                <div class="ibox-content">
                    <table class="table table-striped table-bordered table-hover dataTables-example table-responsive">
                        <thead>
                            <tr>
                                <th width="10%">Order No</th>
                                <th>Order Date</th>
                                <th>Customer Name</th>
                                <th>Address</th>
                                <th class="text-center" width="15%">Order Amount</th>
                                <th class="text-center" width="10%">Status</th>
                                @*<th class="text-center" width="8%">Action</th>*@
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null)
                            {
                                foreach (var item in Model._orderList)
                                {
                                    <tr class="gradeX">
                                        <td width="15%"><a title="View Order" href="@Url.Action("OrderDetail","ManageOrder",new { OrderID = item.OrderID })"><b>@item.OrderNo</b></a></td>
                                        <td width="18%">@item.OrderDate</td>
                                        <td>@item.CustomerName</td>
                                        <td>@item.CustomerAddress</td>
                                        
                                        <td class="text-center"><i class="fa fa-inr" aria-hidden="true"></i> &nbsp;@item.Total</td>
                                        <td class="text-center">
                                            @if (item.OrderStatus == "Placed")
                                            {
                                                <span class="label label-warning" style="font-size:12px;">Placed</span>
                                            }
                                            else if (item.OrderStatus == "Accepted")
                                            {
                                                <span class="label label-primary" style="font-size:12px;">Accepted</span>
                                            }
                                            else if (item.OrderStatus == "Declined" || item.OrderStatus == "Cancelled by Admin" || item.OrderStatus == "Cancelled by user")
                                            {
                                                <span class="label label-danger" style="font-size:12px;">@item.OrderStatus</span>
                                            }
                                            else if (item.OrderStatus == "Ready")
                                            {
                                                <span class="label label-info" style="font-size:12px;">Ready</span>
                                            }
                                            else if (item.OrderStatus == "Delivered")
                                            {
                                                <span class="label label-default" style="font-size:12px;">Delivered</span>
                                            }
                                        </td>
                                        @*<td class="text-center">
            @if (!string.IsNullOrEmpty(item.Invoice))
            {
                <span class="label label-success" style="font-size:12px;">
                    <a title="Order Summary" style="color: #ffffff;" href="@Url.Content(filePath + item.Invoice)" target="_blank">
                        <i class="fa fa-file"></i>&nbsp; Invoice
                    </a>
                </span>
            }
        </td>*@
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>Wallet Credit Request List</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    <table class="table table-striped table-bordered table-hover dataTables-example  table-responsive">
                        <thead>
                            <tr>
                                <th>Customer Name</th>
                                <th class="text-center" width="15%">Requested Amount</th>
                                <th class="text-center" width="10%">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null)
                            {
                                foreach (var item in Model._walletRequest)
                                {
                                    <tr class="gradeX">
                                        <td>@item.UserName</td>
                                        <td><i class="fa fa-inr" aria-hidden="true"></i> &nbsp;@item.Amount</td>
                                        <td class="text-center"><a href="#" onclick="ManageWalletRequest(@item.HistoryID, @item.WalletID, @item.UserID, @item.Amount, 'Approved')"><i class="fa fa-check" aria-hidden="true" style="color: #0e9c7f;font-size: 20px;"></i></a> &nbsp; &nbsp;<a href="#" onclick="ManageWalletRequest(@item.HistoryID, @item.WalletID, @item.UserID, @item.Amount, 'Rejected')"><i class="fa fa-times" aria-hidden="true" style="color:red;font-size: 20px;"></i></a></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>




        <div class="col-lg-6">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>Online Trancation History &nbsp;<i class="fa fa-inr" aria-hidden="true"></i> @Model.OnlineAmount</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    <table class="table table-striped table-bordered table-hover dataTables-example  table-responsive">
                        <thead>
                            <tr>
                                <th>Customer Name</th>
                                <th class="text-center" width="15%">Amount</th>
                                <th class="text-center" width="10%">Payment Date</th>
                                <th class="text-center" width="10%">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null)
                            {
                                foreach (var item in Model._walletData)
                                {
                                    <tr class="gradeX">
                                        <td>@item.UserName</td>
                                        <td><i class="fa fa-inr" aria-hidden="true"></i> &nbsp;@item.Amount</td>
                                        <td>@item.CreatedDate</td>
                                        <td>@item.PaymentStatus</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>














    </div>
</div>

@section Styles {
    @Styles.Render("~/plugins/sweetAlertStyles")
    @Styles.Render("~/Content/plugins/dataTables/dataTablesStyles")
}
@section Scripts{
    @Scripts.Render("~/plugins/dataTables")
    @Scripts.Render("~/plugins/validate")
    @Scripts.Render("~/plugins/sweetAlert")

    <script type="text/javascript">
        $(document).ready(function () {

            $('.dataTables-example').DataTable({
                "order": [[0, "desc"]],
                pageLength: 25,
                dom: '<"html5buttons"B>lTfgitp',
                buttons: [
                    { extend: 'copy' },
                    { extend: 'csv' },
                    { extend: 'excel', title: 'ExampleFile' },
                    { extend: 'pdf', title: 'ExampleFile' },
                    {
                        extend: 'print',
                        customize: function (win) {
                            $(win.document.body).addClass('white-bg');
                            $(win.document.body).css('font-size', '10px');

                            $(win.document.body).find('table')
                                .addClass('compact')
                                .css('font-size', 'inherit');
                        }
                    }
                ]
            });

        });
        // MAnage wallet credit request
        function ManageWalletRequest(HistoryID, WalletID, UserID, Amount, StatusName) {
            var action = "";
            debugger;
            if (StatusName == "Approved") {
                action = "approve";
            } else {
                action = "reject";
            }
            swal({
                title: "Are you sure?",
                text: "You want to " + action + " this request?",
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#DD6B55",
                confirmButtonText: "Yes, " + status + " it!",
                closeOnConfirm: false
            }, function (e) {
                if (e) {
                    $.ajax(
                    {
                        type: "GET",
                        datatype: "JSON",
                        url: "@Url.Action("ManageWalletRequest", "Home")",
                        data: { HistoryID: HistoryID, WalletID: WalletID, UserID: UserID, Amount: Amount, StatusName: StatusName },
                        success: function (data) {
                            if (data != null) {
                                swal(data);
                                window.setTimeout(function () {
                                    location.reload();
                                }, 1000);
                            }
                        },
                        error: function (event, xhr, options, exc) {
                            swal("An error occured please try again !!");
                        }
                    });
                }
            });
        }
    </script>
}