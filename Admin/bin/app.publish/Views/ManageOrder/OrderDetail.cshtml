@model Order_Model
@{
    ViewBag.Title = "Manage Order";
    var count = 1;
}

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-lg-10">
        <h2>Manage Order</h2>
        <ol class="breadcrumb">
            <li>
                <a href="@Url.Action("Index", "Home")">Dashboard</a>
            </li>
            <li>
                <a href="@Url.Action("OrderList", "ManageOrder")">Order List</a>
            </li>
            <li class="active">
                <strong>Order Detail</strong>
            </li>
        </ol>
    </div>
    <div class="col-lg-2">
    </div>
</div>
<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                @using (Html.BeginForm("ManageOrder", "ManageOrder", FormMethod.Post, new { @id = "frmAddUpdate", @enctype = "multipart/form-data" }))
                {
                    @Html.HiddenFor(m => m.OrderID)
                    @Html.HiddenFor(m => m.UserID)
                    <input type="hidden" name="FromDate" value="@ViewBag.FromDate" />
                    <input type="hidden" name="ToDate" value="@ViewBag.ToDate" />
                    <div class="col-lg-12">
                        <div class="ibox ">
                            <div class="ibox-content">

                                <div class="row">
                                    <div class="col-md-12">
                                        <ul class="sortable-list connectList agile-list">
                                            <li class="success-element">
                                                @Html.Label("Order Summary")
                                            </li>
                                        </ul>
                                    </div>
                                </div>

                                <div class="form-group row">
                                    <div class="col-sm-3">
                                        @Html.Label("Order No")
                                        @Html.TextBoxFor(m => m.OrderNo, new { @class = "form-control", @id = "OrderNo", @name = "OrderNo", @readonly = true })
                                    </div>
                                    <div class="col-sm-3">
                                        @Html.Label("Order Date")
                                        @Html.TextBoxFor(m => m.OrderDate, new { @class = "form-control", @id = "OrderDate", @name = "OrderDate", @readonly = true })
                                    </div>
                                    <div class="col-sm-3">
                                        @Html.Label("Status")
                                        @Html.DropDownListFor(m => m.OrderStatus, CommonHelper.OrderStatus(), new { @class = "form-control" })
                                    </div>
                                </div>

                                <div class="form-group row" id="DeliveryID">
                                    <div class="col-sm-3">
                                        @Html.Label("Delivery Date") <b style="color:red"> *</b>
                                        @Html.TextBoxFor(m => m.DeliveryDate, new { @class = "form-control", @id = "DeliveryDate", @name = "DeliveryDate" })
                                    </div>
                                    <div class="col-sm-3">
                                        @Html.Label("Delivery Time") <b style="color:red"> *</b>
                                        @Html.TextBoxFor(m => m.DeliveryTime, new { @class = "form-control", @id = "DeliveryTime", @name = "DeliveryTime" })
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-12">
                                        <ul class="sortable-list connectList agile-list">
                                            <li class="success-element">
                                                @Html.Label("Customer Information")
                                            </li>
                                        </ul>
                                    </div>
                                </div>

                                <div class="form-group row">
                                    <div class="col-sm-12">
                                        @Html.Label("Customer Name")
                                        @Html.TextBoxFor(m => m.CustomerName, new { @placeholder = "Customer Name", @class = "form-control", @id = "CustomerName", @name = "CustomerName" })
                                    </div>
                                </div>

                                <div class="form-group row">
                                    <div class="col-sm-6">
                                        @Html.Label("Customer Mobile")
                                        @Html.TextBoxFor(m => m.CustomerMobile, new { @placeholder = "Customer Mobile", @class = "form-control", @id = "CustomerMobile", @name = "CustomerMobile" })
                                    </div>
                                    <div class="col-sm-6">
                                        @Html.Label("Customer Email")
                                        @Html.TextBoxFor(m => m.CustomerEmail, new { @placeholder = "Customer Email", @class = "form-control", @id = "Customer Email", @name = "Customer Email" })
                                    </div>
                                </div>

                                <div class="form-group row">
                                    <div class="col-sm-6">
                                        @Html.Label("Customer Address")
                                        @Html.TextAreaFor(m => m.CustomerAddress, new { @placeholder = "Customer Address", @class = "form-control", @id = "Customer Address", @name = "Customer Address" })
                                    </div>
                                    <div class="col-sm-6">
                                        @Html.Label("Delivery Address")
                                        @Html.TextAreaFor(m => m.DeliveryAddress, new { @placeholder = "Delivery Address", @class = "form-control", @id = "Delivery Address", @name = "Delivery Address" })
                                    </div>
                                </div>

                                <div class="form-group row">
                                    <div class="col-sm-12">
                                        @Html.Label("Customer Remark")
                                        @Html.TextAreaFor(m => m.CustomerRemark, new { @placeholder = "Customer Remark", @class = "form-control", @id = "CustomerRemark", @name = "CustomerRemark" })
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-12">
                                        <ul class="sortable-list connectList agile-list">
                                            <li class="success-element">
                                                @Html.Label("Payment Details")
                                            </li>
                                        </ul>
                                    </div>
                                </div>

                                <div class="form-group row">
                                    <div class="col-sm-3">
                                        @Html.Label("Total Amount")
                                        @Html.TextBoxFor(m => m.Total, new { @class = "form-control", @id = "Total", @name = "Total", @readonly = true })
                                    </div>
                                    <div class="col-sm-3">
                                        @Html.Label("Billing Amount")
                                        @Html.TextBoxFor(m => m.BillingAmount, new { @class = "form-control", @id = "BillingAmount", @name = "BillingAmount", @readonly = true })
                                    </div>
                                    @*<div class="col-sm-3">
                                @Html.Label("Payment Status") <b style="color:red" id="ErrorID"> *</b>
                                @Html.DropDownListFor(m => m.PaymentStatus, CommonHelper.PaymentStatus(), new { @class = "form-control" })
                                <label id="PaymentStatusError" class="error">Please update payment status</label>
                            </div>*@
                                </div>

                                <div class="row">
                                    <div class="col-md-12">
                                        <ul class="sortable-list connectList agile-list">
                                            <li class="success-element">
                                                @Html.Label("Item List")
                                            </li>
                                        </ul>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-12">
                                        <table class="table table-striped table-bordered table-hover dataTables-example">
                                            <thead>
                                                <tr>
                                                    <th width="5%">Sr.No</th>
                                                    <th>Item Name</th>
                                                    <th width="15%">Available Stock</th>
                                                    <th width="15%">Order Weight</th>
                                                    <th>Order Qty</th>
                                                    <th width="15%">Delivery Weight</th>
                                                    <th class="text-center">Actual Price</th>
                                                    <th class="text-center" width="15%">Price</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model != null)
                                                {
                                                    for (int i = 0; i < Model._itemList.Count; i++)
                                                    {
                                                        @Html.HiddenFor(m => Model._itemList[i].OrderItemID)
                                                        @Html.HiddenFor(m => Model._itemList[i].OrderID)
                                                        @Html.HiddenFor(m => Model._itemList[i].SubItemID, new { @id = "_itemList[" + @i + "].SubItemID", @name = "_itemList[" + @i + "].SubItemID" })
                                                        @Html.HiddenFor(m => Model._itemList[i].SubItemUnitName, new { @id = "_itemList[" + @i + "].SubItemUnitName", @name = "_itemList[" + @i + "].SubItemUnitName" })
                                                        @Html.HiddenFor(m => Model._itemList[i].ItemID, new { @id = "_itemList[" + @i + "].ItemID", @name = "_itemList[" + @i + "].ItemID" })
                                                        @Html.HiddenFor(m => Model._itemList[i].StockID)
                                                        @Html.HiddenFor(m => Model._itemList[i].MainID)
                                                        @Html.HiddenFor(m => Model._itemList[i].Price, new { @id = "_itemList[" + @i + "].Price", @name = "_itemList[" + @i + "].Price" })
                                                        <tr class="gradeX">
                                                            <td>@count</td>
                                                            <td>@Model._itemList[i].ItemName</td>
                                                            <td>
                                                                @if (!string.IsNullOrEmpty(Model._itemList[i].AvailableStock))
                                                                {
                                                                    @Model._itemList[i].AvailableStock
                                                                }
                                                                else
                                                                {
                                                                    <span style="color:red;">No Purchase</span>
                                                                }
                                                            </td>
                                                            <td>@Model._itemList[i].Weight</td>
                                                            <td width="10%">@Model._itemList[i].OrderQty</td>
                                                            <td>
                                                                @Html.TextBoxFor(m => m._itemList[i].DeliveryWeight, new { @placeholder = "Delivery Weight", @class = "form-control", @id = "_itemList[" + @i + "].DeliveryWeight", @name = "_itemList[" + @i + "].DeliveryWeight", @onkeyup = "fncalPrice(" + @i + ")" })
                                                            </td>
                                                            <td width="10%" class="text-center">@Model._itemList[i].Price</td>
                                                            <td>
                                                                @Html.TextBoxFor(m => m._itemList[i].DeliveryPrice, new { @placeholder = "Price", @class = "form-control", @id = "_itemList[" + @i + "].DeliveryPrice", @name = "_itemList[" + @i + "].DeliveryPrice" })
                                                            </td>
                                                        </tr>
                                                        count++;
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <hr />
                                <div class="form-group row">
                                    <div class="col-sm-7 col-sm-offset-5">
                                        <button type="submit" id="btnSubmit" class="btn btn-primary" onkeypress="return event.keyCode != 13;"><i class="fa fa-save"></i>&nbsp; Save</button>&nbsp;&nbsp;
                                        <a class="btn btn-white"
                                           href="@Url.Action("OrderList", "ManageOrder", new {
       FromDate = ViewBag.FromDate,
       ToDate = ViewBag.ToDate
   })"
                                           id="btnSubmit">
                                            <i class="fa fa-times"></i>&nbsp;Back to List
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    @Styles.Render("~/plugins/clockpickerStyles")
    @Styles.Render("~/plugins/dateRangeStyles")
    @Styles.Render("~/plugins/awesomeCheckboxStyles")
    @Styles.Render("~/Content/plugins/iCheck/iCheckStyles")
    @Styles.Render("~/Content/plugins/chosen/chosenStyles")
    @Styles.Render("~/plugins/dataPickerStyles")
    @Styles.Render("~/plugins/select2Styles")
    @Styles.Render("~/plugins/sweetAlertStyles")
    @Styles.Render("~/plugins/select2Styles")
}
@section Scripts{
    @Scripts.Render("~/plugins/iCheck")
    @Scripts.Render("~/plugins/dataPicker")
    @Scripts.Render("~/plugins/chosen")
    @Scripts.Render("~/plugins/clockpicker")
    @Scripts.Render("~/plugins/dateRange")
    @Scripts.Render("~/plugins/select2")
    @Scripts.Render("~/plugins/validate")
    @Scripts.Render("~/plugins/sweetAlert")
    @Scripts.Render("~/plugins/select2")

    <script type="text/javascript">
        $(document).ready(function () {

            //$("#PaymentStatusError").hide();
            $("#ErrorID").hide();
            //$("#DeliveryID").hide();

            if ('@Model.DeliveryDate' != "" && '@Model.DeliveryTime') {
                $("#DeliveryID").show();
            }

            if ('@TempData["SuccessMessage"]' != '') {
                sweetAlert("Sucesss!!", '@TempData["SuccessMessage"]', "success");
            }
            if ('@TempData["ErrorMessage"]' != '') {
                sweetAlert("Error!!", '@TempData["ErrorMessage"]', "error");
            }

            $("#ItemName").blur(function () {
                if ($("#ItemID").val() == "0") {
                    var ItemName = $("#ItemName").val();
                    $.ajax({
                        url: '@Url.Action("CheckItemIsExist", "Item")',
                        type: "GET",
                        dataType: "JSON",
                        data: { ItemName: ItemName },
                        success: function (data) {
                            if (data == 'Exist') {
                                $("#Itemerror").show();
                                document.getElementById("btnSubmit").disabled = true;
                            } else {
                                $("#Itemerror").hide();
                                document.getElementById("btnSubmit").disabled = false;
                            }
                        }
                    });
                }
            });
        
        });

        function fncalPrice(index) {
            var DeliveryWeight = document.getElementById('_itemList[' + index + '].DeliveryWeight').value;
            var ActualPrice = document.getElementById('_itemList[' + index + '].Price').value;
            var SubItemID = document.getElementById('_itemList[' + index + '].SubItemID').value;
            var ItemID = document.getElementById('_itemList[' + index + '].ItemID').value;

            var DeliveryPrice = document.getElementById('_itemList[' + index + '].DeliveryPrice').value;

            $.ajax(
                {
                    type: "GET",
                    url: '@Url.Action("CalculateOrderPrice", "ManageOrder")',
                    contentType: 'application/json; charset=utf-8',
                    data: { DeliveryWeight: DeliveryWeight, ItemID: ItemID, SubItemID: SubItemID, Price: ActualPrice },
                    dataType: "JSON",
                    success: function (data) {
                        document.getElementById('_itemList[' + index + '].DeliveryPrice').value = data;
                    },
                    error: function (event, xhr, options, exc) {
                    }
                });
        }

    </script>
}