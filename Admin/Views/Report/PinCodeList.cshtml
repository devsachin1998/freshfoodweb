@model Pincode_Modal
@{
    ViewBag.Title = "PinCodeList";
    int count = 1;
}

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-lg-10">
        <h2>PinCode</h2>
        <ol class="breadcrumb">
            <li>
                <a href="@Url.Action("Index", "Home")">Dashboard</a>
            </li>
            <li class="active">
                <strong>Manage PinCode</strong>
            </li>
        </ol>
    </div>
    <div class="col-lg-2">
    </div>
</div>
<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>Add | Edit PinCode</h5>
                </div>
                <div class="ibox-content">
                    @using (Html.BeginForm("SavePincode", "Report", FormMethod.Post, new { @id = "frmAddUpdate", @enctype = "multipart/form-data" }))
                    {
                        @Html.HiddenFor(m => m.PinID)
                    <div class="form-group row">
                        <div class="col-sm-6">
                            @Html.Label("Location Name") <b style="color:red"> *</b>
                            @Html.TextBoxFor(m => m.LocationName, new { @class = "form-control", @id = "LocationName", @name = "LocationName", @autocomplete = "off", })

                        </div>
                        <div class="col-sm-6">
                            @Html.Label("Location Pincode") <b style="color:red"> *</b>
                            @Html.TextBoxFor(m => m.LocationCode, new
                       {
                           @class = "form-control",
                           @id = "LocationCode",
                           @name = "LocationCode",
                           @autocomplete = "off",
                           maxlength = "6",
                           pattern = @"\d{6}",
                           title = "Please enter a 6-digit number only"

                       })
                        </div>
                        <div class="col-md-3" style="margin-top: 23px;">
                            <button type="submit" id="btnSubmit" class="btn btn-primary" onkeypress="return event.keyCode != 13;"><i class="fa fa-save"></i>&nbsp; Save</button>
                            &nbsp;&nbsp;
                            <a class="btn btn-white" href="@Url.Action("PinCodeList", "Report")"><i class="fa fa-refresh"></i>&nbsp; Reset</a>
                        </div>
                    </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>PinCode List</h5>
                </div>
                <div class="ibox-content">
                    <table class="table table-striped table-bordered table-hover dataTables-example">
                        <thead>
                            <tr>
                                <th width="5%">Sr.No</th>
                                <th>Location Name</th>
                                <th>Location Pin Code</th>
                                <th class="text-center" width="30%">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null)
                            {
                                foreach (var item in Model._locationList)
                                {

                                    <tr class="gradeX">
                                        <td>@count</td>
                                        <td>@item.LocationName</td>
                                        <td>@item.LocationCode</td>
                                        <td class="text-center">
                                            @if (item.IsActive.Equals("1"))
                                            {
                                                <span class="label label-primary" style="font-size:12px;background-color:#629607;">
                                                    <a style="color: #ffffff;" title="Active" onclick="ManageLocation(@item.PinID, 0)">
                                                        Active
                                                    </a>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="label label-danger" style="font-size: 12px">
                                                    <a style="color: #ffffff;" title="InActive" onclick="ManageLocation(@item.PinID, 1)">
                                                        InActive
                                                    </a>
                                                </span>
                                            }
                                            <span>&nbsp;&nbsp;</span>
                                            <span class="label label-danger" style="font-size:12px;">
                                                <a title="Delete Category" style="color: #ffffff;" href="#" onclick="fnDeleteCategory(@item.PinID)">
                                                    <i class="fa fa-trash"></i>&nbsp; Delete
                                                </a>
                                            </span>
                                        </td>


                                        @*<td>
            <span class="label label-primary" style="font-size:12px;">
                <a title="Edit Details" style="color: #ffffff;" href="#" onclick="EditDetail(@item.CategoryID, '@item.CategoryName', '@item.MobileNo')">
                    <i class="fa fa-pencil"></i>&nbsp; Edit
                </a>
            </span>
        </td>*@
                                    </tr>
                                    count++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
@section Styles {
    @Styles.Render("~/Content/plugins/dataTables/dataTablesStyles")
    @Styles.Render("~/plugins/sweetAlertStyles")
    @Styles.Render("~/plugins/dataPickerStyles")
    @Styles.Render("~/plugins/select2Styles")
}

@section Scripts {
    @Scripts.Render("~/plugins/dataTables")
    @Scripts.Render("~/plugins/sweetAlert")
    @Scripts.Render("~/plugins/validate")
    @Scripts.Render("~/plugins/dataPicker")
    @Scripts.Render("~/plugins/select2")

<script type="text/javascript">
        $(document).ready(function () {

            $("#CategoryError").hide();

            if ('@TempData["SuccessMessage"]' != '') {
                sweetAlert("Sucesss!!", '@TempData["SuccessMessage"]', "success");
            }
            if ('@TempData["ErrorMessage"]' != '') {
                sweetAlert("Error!!", '@TempData["ErrorMessage"]', "error");
            }

            $('.dataTables-example').DataTable({
                pageLength: 25,
                dom: '<"html5buttons"B>lTfgitp',
                buttons: [
                    { extend: 'copy' },
                    { extend: 'csv' },
                    { extend: 'excel', title: 'ExampleFile' },
                    { extend: 'pdf', title: 'ExampleFile' },
                    {
                        extend: 'print',
                        customize: function (win) {
                            $(win.document.body).addClass('white-bg');
                            $(win.document.body).css('font-size', '10px');

                            $(win.document.body).find('table')
                                .addClass('compact')
                                .css('font-size', 'inherit');
                        }
                    }
                ]
            });

            $("#frmAddUpdate").validate({
                rules: {
                    LocationName: {
                        required: true
                    },
                    LocationCode: {
                        required: true,
                        digits: true,       // only numbers
                        minlength: 6,       // exactly 6 digits
                        maxlength: 6
                    }
                },
                messages: {
                    LocationName: {
                        required: "Please enter location name"
                    },
                    LocationCode: {
                        required: "Please enter location pincode",
                        digits: "Please enter numbers only",
                        minlength: "Pincode must be exactly 6 digits",
                        maxlength: "Pincode must be exactly 6 digits"
                    }
                },
                errorClass: "text-danger",
                errorPlacement: function (error, element) {
                    error.css({
                        display: 'block',
                        position: 'absolute',
                        color: 'red',
                        marginTop: '2px'
                    });
                    error.insertAfter(element);
                }
            });


        });

        function fnCheckCategoryName() {

            if ($("#CategoryID").val() == "0") {
                var CategoryName = $("#CategoryName").val();
                $.ajax({
                    url: '@Url.Action("CheckCategoryIsExist", "Category")',
                    type: "GET",
                    dataType: "JSON",
                    data: { CategoryName: CategoryName },
                    success: function (data) {
                        if (data != '') {
                            $("#CategoryError").show();
                            document.getElementById("btnSubmit").disabled = true;
                        } else {
                            $("#CategoryError").hide();
                            document.getElementById("btnSubmit").disabled = false;
                        }
                    }
                });
            }
        }
    function ManageLocation(CatID, Status) {
            var action = "";
            if (Status=="0") {
                action = "Inactive";
            } else {
                action = "Active";
            }
            swal({
                title: "Are you sure?",
                text: "You want to " + action + " this location?",
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#DD6B55",
                confirmButtonText: "Yes, " + status + " it!",
                closeOnConfirm: false
            }, function (e) {
                if (e) {
                    $.ajax(
                    {
                        type: "Post",
                        datatype: "JSON",
                        url: "@Url.Action("ManageLocation", "Report")",
                            data: { PinID: CatID,  Status: Status },
                        success: function (data) {
                            if (data != null) {
                                swal(data);
                                window.setTimeout(function () {
                                    location.reload();
                                }, 1000);
                            }
                        },
                        error: function (event, xhr, options, exc) {
                            swal("An error occured please try again !!");
                        }
                    });
                }
            });
    }







    function fnDeleteCategory(PinID) {
            swal({
                title: "Are you sure?",
                text: "You want to delete this Category?",
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#DD6B55",
                closeOnConfirm: false
            }, function (e) {
                if (e) {
                    $.ajax(
                        {
                            type: "GET",
                            url: '@Url.Action("DeleteLocation", "Report")',
                            contentType: 'application/json; charset=utf-8',
                            data: { PinID: PinID },
                            dataType: "JSON",
                            success: function (data) {
                                swal(data);
                                window.setTimeout(function () {
                                    location.reload();
                                }, 1000);
                            },
                            error: function (event, xhr, options, exc) {
                                sweetAlert("Error!!", data, "error");
                            }
                        });
                }
            });
        }


        //function EditDetail(CategoryID, CategoryName, MobileNo) {
        //    $('.form-group').removeClass('has-success has-error');
        //    $('.help-block').remove();
        //    $('#frmAddUpdate')[0].reset();
        //    $('#frmAddUpdate').validate().resetForm();
        //    $("#CategoryID").val(CategoryID);
        //    $("#CategoryName").val(CategoryName);
        //    $("#MobileNo").val(MobileNo);
        //}

</script>
}