@model Wallet_Model

@{
    ViewBag.Title = "AddMoney";
}

<div class="row wrapper border-bottom white-bg page-heading">

    <div class="col-lg-10">

        <h2>Wallet</h2>

        <ol class="breadcrumb">

            <li>
                <a href="@Url.Action("Index", "Home")">
                    Dashboard
                </a>
            </li>

            <li class="active">
                <strong>Add Money</strong>
            </li>

        </ol>

    </div>

    <div class="col-lg-2">
    </div>

</div>


<div class="wrapper wrapper-content animated fadeInRight">

    <div class="row">

        <div class="col-lg-12">

            <div class="ibox float-e-margins">

                <div class="ibox-title">

                    <h5>Add Money</h5>

                </div>

                <div class="ibox-content">

                    @using (Html.BeginForm(
                        "AddMoney",
                        "Wallet",
                        FormMethod.Post,
                        new
                        {
                            @id = "frmAddUpdate",
                            @enctype = "multipart/form-data"
                        }))
                    {

                        @Html.HiddenFor(m => m.WalletID)


                        <div class="form-group row">

                            <div class="col-sm-3">

                                @Html.Label("Customer Name")
                                <b style="color:red">*</b>

                                <select id="UserID"
                                        name="UserID"
                                        class="select2_demo_1 form-control"
                                        style="width:100%;">

                                    <option value="">
                                        Select Customer
                                    </option>

                                </select>

                            </div>


                            <div class="col-sm-3">

                                @Html.Label("Add Balance")
                                <b style="color:red">*</b>

                                @Html.TextBoxFor(
                                    m => m.Amount,
                                    new
                                    {
                                        @class = "form-control",
                                        @id = "Amount",
                                        @name = "Amount",
                                        @autocomplete = "off",
                                        @placeholder = "Enter Amount"
                                    })

                            </div>

                        </div>


                        <div class="form-group row">

                            <div class="col-md-3"
                                 style="margin-top:23px;">

                                <button type="submit"
                                        id="btnSubmit"
                                        class="btn btn-primary"
                                        onkeypress="return event.keyCode != 13;">

                                    <i class="fa fa-save"></i>
                                    &nbsp; Save

                                </button>

                                &nbsp;&nbsp;

                                <a class="btn btn-white"
                                   href="@Url.Action("AddMoney", "Wallet")">

                                    <i class="fa fa-refresh"></i>
                                    &nbsp; Reset

                                </a>

                            </div>

                        </div>

                    }

                </div>

            </div>

        </div>

    </div>

</div>


<div class="wrapper wrapper-content animated fadeInRight">

    <div class="row">

        <div class="col-lg-12">

            <div class="ibox float-e-margins">

                <div class="ibox-content">

                    <!-- Horizontal Scroll Wrapper -->
                    <div class="wallet-table-wrapper">

                        <table id="walletTable"
                               class="table table-striped table-bordered table-hover dataTables-example"
                               style="width:100%; min-width:900px;">

                            <thead>

                                <tr>

                                    <th width="12%">
                                        Customer Id
                                    </th>

                                    <th>
                                        Customer Name
                                    </th>

                                    <th>
                                        Address
                                    </th>

                                    <th>
                                        Mobile No
                                    </th>

                                    <th class="text-right"
                                        width="20%">

                                        Wallet Balance

                                    </th>

                                    <th class="text-center"
                                        width="15%">

                                    </th>

                                </tr>

                            </thead>


                            <tbody id="walletTableBody">

                                <tr>

                                    <td colspan="6"
                                        class="text-center text-muted">

                                        Please select a customer to
                                        view wallet details.

                                    </td>

                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


@section Styles
{

    @Styles.Render(
        "~/Content/plugins/dataTables/dataTablesStyles"
    )

    @Styles.Render(
        "~/plugins/sweetAlertStyles"
    )

    @Styles.Render(
        "~/plugins/dataPickerStyles"
    )

    @Styles.Render(
        "~/plugins/select2Styles"
    )


    <style>

        /* ==========================================
           Wallet Table Horizontal Scroll
           ========================================== */

        .wallet-table-wrapper {
            width: 100% !important;
            max-width: 100% !important;
            overflow-x: auto !important;
            overflow-y: hidden !important;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: auto;
        }


            .wallet-table-wrapper table {
                min-width: 900px !important;
                width: 900px !important;
            }


            .wallet-table-wrapper th,
            .wallet-table-wrapper td {
                vertical-align: middle;
                white-space: nowrap;
            }


        /* DataTable wrapper */

        #walletTable_wrapper {
            width: 100% !important;
        }


            #walletTable_wrapper .dataTables_length {
                margin-bottom: 10px;
            }


            #walletTable_wrapper .dataTables_filter {
                margin-bottom: 10px;
            }


            #walletTable_wrapper .dataTables_info {
                margin-top: 10px;
            }


            #walletTable_wrapper .dataTables_paginate {
                margin-top: 10px;
            }


        /* ==========================================
           Mobile
           ========================================== */

        @@media (max-width: 767px) {

            .wallet-table-wrapper {
                display: block !important;
                width: 100% !important;
                max-width: 100% !important;
                overflow-x: scroll !important;
                overflow-y: hidden !important;
                -webkit-overflow-scrolling: touch;
            }


                .wallet-table-wrapper table {
                    display: table !important;
                    width: 900px !important;
                    min-width: 900px !important;
                    max-width: none !important;
                }


                .wallet-table-wrapper th,
                .wallet-table-wrapper td {
                    white-space: nowrap !important;
                    padding: 8px !important;
                }


            .ibox-content {
                overflow: hidden;
            }
            /*
               Important:
               Don't let DataTables make the table smaller
            */

            #walletTable {
                width: 900px !important;
                min-width: 900px !important;
            }
        }
    </style>

}


@section Scripts
{

    @Scripts.Render(
        "~/plugins/dataTables"
    )

    @Scripts.Render(
        "~/plugins/sweetAlert"
    )

    @Scripts.Render(
        "~/plugins/validate"
    )

    @Scripts.Render(
        "~/plugins/dataPicker"
    )

    @Scripts.Render(
        "~/plugins/select2"
    )


    <script type="text/javascript">

        $(document).ready(function () {

            var $customer =
                $('#UserID');

            var $tbody =
                $('#walletTableBody');


            if ($('#Amount').val() == '0') {

                $('#Amount').val('');

            }


            /* ==========================================
               Customer Select2
               ========================================== */

            $customer.select2({

                placeholder:
                    'Select Customer',

                allowClear: true,

                minimumInputLength: 2,

                width: '100%',

                ajax: {

                    url:
                        '@Url.Action("GetCustomers", "Wallet")',

                    type: 'GET',

                    dataType: 'json',

                    delay: 200,

                    cache: true,

                    data: function (params) {

                        return {
                            term: params.term || ''
                        };

                    },

                    processResults: function (data) {

                        return {

                            results:
                                (data &&
                                 data.results)
                                    ? data.results
                                    : []

                        };

                    }

                }

            });


            /* ==========================================
               Escape HTML
               ========================================== */

            function escapeHtml(value) {

                return $('<div/>')
                    .text(
                        value == null
                            ? ''
                            : value
                    )
                    .html();

            }


            /* ==========================================
               Show Message
               ========================================== */

            function showMessage(
                message,
                cssClass
            ) {

                $tbody.html(

                    '<tr>' +

                        '<td colspan="6" ' +
                        'class="text-center ' +
                        (cssClass ||
                            'text-muted') +
                        '">' +

                            escapeHtml(message) +

                        '</td>' +

                    '</tr>'

                );

            }


            /* ==========================================
               Load Customer Wallet
               ========================================== */

            function loadCustomerWallet(userId) {

                if (!userId) {

                    $('#WalletID').val('');

                    showMessage(
                        'Please select a customer to view wallet details.',
                        'text-muted'
                    );

                    return;

                }


                showMessage(
                    'Loading...',
                    'text-muted'
                );


                $.ajax({

                    url:
                        '@Url.Action(
                            "GetCustomerWallet",
                            "Wallet"
                        )',

                    type: 'GET',

                    dataType: 'json',

                    data: {
                        UserID: userId
                    },

                    cache: false,


                    success: function (response) {

                        console.log(
                            'GetCustomerWallet:',
                            response
                        );


                        if (!response ||
                            response.success !== true) {

                            $('#WalletID').val('');

                            showMessage(

                                response &&
                                response.message
                                    ? response.message
                                    : 'Customer data not found.',

                                'text-danger'

                            );

                            return;

                        }


                        $('#WalletID').val(
                            response.WalletID || ''
                        );


                        var balance =
                            parseFloat(
                                response.Balance || 0
                            );


                        var balanceText =
                            balance.toFixed(2);


                        var balanceHtml =
                            balance > 0

                                ? '<span style="color:green;font-weight:bold;">' +
                                  balanceText +
                                  '</span>'

                                : '<span style="color:red;font-weight:bold;">' +
                                  balanceText +
                                  '</span>';


                        var historyHtml = '';


                        if (balance !== 0) {

                            historyHtml =

                                '<a title="View History" ' +
                                'class="btn btn-xs btn-success" ' +
                                'href="' +

                                '@Url.Action(
                                    "PaymentHistory",
                                    "Wallet"
                                )?UserID=' +

                                encodeURIComponent(
                                    response.UserID
                                ) +

                                '">' +

                                    '<i class="fa fa-history"></i>' +
                                    '&nbsp; View History' +

                                '</a>';

                        }


                        var row =

                            '<tr>' +

                                '<td>' +
                                    '<b>' +
                                        escapeHtml(
                                            response.UserID
                                        ) +
                                    '</b>' +
                                '</td>' +

                                '<td>' +
                                    escapeHtml(
                                        response.UserName
                                    ) +
                                '</td>' +

                                '<td>' +
                                    escapeHtml(
                                        response.Address
                                    ) +
                                '</td>' +

                                '<td>' +
                                    escapeHtml(
                                        response.Mobile
                                    ) +
                                '</td>' +

                                '<td class="text-right">' +

                                    '<i class="fa fa-inr"></i>' +
                                    '&nbsp;' +
                                    balanceHtml +

                                '</td>' +

                                '<td class="text-center">' +

                                    historyHtml +

                                '</td>' +

                            '</tr>';


                        /* Only selected customer */

                        $tbody.html(row);

                    },


                    error: function (xhr) {

                        console.log(
                            'GetCustomerWallet error:',
                            xhr.responseText
                        );

                        showMessage(
                            'Unable to load customer wallet details.',
                            'text-danger'
                        );

                    }

                });

            }


            /* ==========================================
               Customer Change
               ========================================== */

            $customer.on(
                'change',
                function () {

                    loadCustomerWallet(
                        $(this).val()
                    );

                }
            );


            /* ==========================================
               Sweet Alert
               ========================================== */

            @if (TempData["SuccessMessage"] != null)
            {
                <text>

                sweetAlert(
                    'Success!!',
                    '@TempData["SuccessMessage"]',
                    'success'
                );

                </text>
            }


            @if (TempData["ErrorMessage"] != null)
            {
                <text>

                sweetAlert(
                    'Error!!',
                    '@TempData["ErrorMessage"]',
                    'error'
                );

                </text>
            }


            /* ==========================================
               Validation
               ========================================== */

            $('#frmAddUpdate').validate({

                rules: {

                    UserID: {

                        required: true

                    },

                    Amount: {

                        required: true,

                        number: true,

                        min: 0.01

                    }

                },


                messages: {

                    UserID: {

                        required:
                            'Please select customer'

                    },

                    Amount: {

                        required:
                            'Please enter amount',

                        number:
                            'Please enter a valid amount',

                        min:
                            'Amount must be greater than 0'

                    }

                },


                submitHandler: function (form) {

                    $('#btnSubmit')
                        .prop(
                            'disabled',
                            true
                        );

                    form.submit();

                }

            });

        });

    </script>

}