@model User_Model
@{
    ViewBag.Title = "Manage User";
}

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-lg-10">
        <h2>Manage User</h2>
        <ol class="breadcrumb">
            <li>
                <a href="@Url.Action("Index", "Home")">Dashboard</a>
            </li>
            <li>
                <a href="@Url.Action("UserList", "Account")">User List</a>
            </li>
            <li class="active">
                <strong>User Details</strong>
            </li>
        </ol>
    </div>
    <div class="col-lg-2">
    </div>
</div>
<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                @using (Html.BeginForm("SaveUserData", "Account", FormMethod.Post, new { @id = "frmAddUpdate", @enctype = "multipart/form-data" }))
                {
                    @Html.HiddenFor(m => m.UserID)
                    <div class="col-lg-12">
                        <div class="ibox ">
                            <div class="ibox-content">
                                <div class="row">
                                    <div class="col-md-12">
                                        <ul class="sortable-list connectList agile-list">
                                            <li class="success-element">
                                                @Html.Label("User Details")
                                            </li>
                                        </ul>
                                    </div>
                                </div>

                                <div class="form-group row">
                                    <div class="col-sm-12">
                                        @Html.Label("Name") <b style="color:red">*</b>
                                        @Html.TextBoxFor(m => m.Name, new { @placeholder = "Enter Name", @class = "form-control", @id = "Name", @name = "Name" })
                                        <label id="Nameerror" class="error" style="display:none;">Entered name is already exist</label>
                                    </div>
                                </div>

                                <div class="form-group row">
                                    <div class="col-sm-6">
                                        @Html.Label("Email") <b style="color:red">*</b>
                                        @Html.TextBoxFor(m => m.Email, new { @placeholder = "Enter Email", @class = "form-control", @id = "Email", @name = "Email" })
                                    </div>
                                    <div class="col-sm-6">
                                        @Html.Label("Mobile No") <b style="color:red">*</b>
                                        @Html.TextBoxFor(m => m.MobileNo, new { @placeholder = "Enter Mobile No", @class = "form-control", @id = "MobileNo", @name = "MobileNo" })
                                    </div>
                                </div>

                                <div class="form-group row">
                                    <div class="col-sm-6">
                                        @Html.Label("User Name") <b style="color:red">*</b>
                                        @Html.TextBoxFor(m => m.UserName, new { @placeholder = "Enter User Name", @class = "form-control", @id = "UserName", @name = "UserName" })
                                    </div>
                                    <div class="col-sm-6">
                                        @Html.Label("Password") <b style="color:red">*</b>
                                        @Html.TextBoxFor(m => m.Password, new { @placeholder = "Enter Password", @class = "form-control", @id = "Password", @name = "Password" })
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-sm-6">
                                        @Html.Label("Address") <b style="color:red">*</b>
                                        @Html.TextAreaFor(m => m.Address, new { @placeholder = "Enter User Address", @class = "form-control", @id = "Address", @name = "Address" })
                                    </div>
           
                                </div>

                                <hr />
                                <div class="form-group row">
                                    <div class="col-sm-7 col-sm-offset-5">
                                        <button type="submit" id="btnSubmit" class="btn btn-primary" onkeypress="return event.keyCode != 13;"><i class="fa fa-save"></i>&nbsp; Submit</button>&nbsp;&nbsp;
                                        <a class="btn btn-white" href="@Url.Action("UserList", "Account")" id="btnSubmit"><i class="fa fa-times"></i>&nbsp;Cancel</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    @Styles.Render("~/plugins/clockpickerStyles")
    @Styles.Render("~/plugins/dateRangeStyles")
    @Styles.Render("~/plugins/awesomeCheckboxStyles")
    @Styles.Render("~/Content/plugins/iCheck/iCheckStyles")
    @Styles.Render("~/Content/plugins/chosen/chosenStyles")
    @Styles.Render("~/plugins/dataPickerStyles")
    @Styles.Render("~/plugins/select2Styles")
    @Styles.Render("~/plugins/sweetAlertStyles")
    @Styles.Render("~/plugins/select2Styles")
}
@section Scripts{
    @Scripts.Render("~/plugins/iCheck")
    @Scripts.Render("~/plugins/dataPicker")
    @Scripts.Render("~/plugins/chosen")
    @Scripts.Render("~/plugins/clockpicker")
    @Scripts.Render("~/plugins/dateRange")
    @Scripts.Render("~/plugins/select2")
    @Scripts.Render("~/plugins/validate")
    @Scripts.Render("~/plugins/sweetAlert")
    @Scripts.Render("~/plugins/select2")

    <script type="text/javascript">
        $(document).ready(function () {

            $("#Itemerror").hide();

            if ('@TempData["SuccessMessage"]' != '') {
                sweetAlert("Sucesss!!", '@TempData["SuccessMessage"]', "success");
            }
            if ('@TempData["ErrorMessage"]' != '') {
                sweetAlert("Error!!", '@TempData["ErrorMessage"]', "error");
            }

            $("#Name").blur(function () {
                if ($("#UserID").val() == "0") {
                    var Name = $("#Name").val();
                    $.ajax({
                        url: '@Url.Action("CheckNameIsExist", "Account")',
                        type: "GET",
                        dataType: "JSON",
                        data: { Name: Name },
                        success: function (data) {
                            debugger;
                            if (data == 'Exist') {
                                $("#Nameerror").show();
                                document.getElementById("btnSubmit").disabled = true;
                            } else {
                                $("#Nameerror").hide();
                                document.getElementById("btnSubmit").disabled = false;
                            }
                        }
                    });
                }
            });

            $("#frmAddUpdate").validate({
                rules: {
                    Name: {
                        required: true,
                    },
                    UserName: {
                        required: true
                    },
                    Password: {
                        required: true
                    },
                    MobileNo: {
                        required: true
                    },
                    Email: {
                        required: true
                    }
                },
                messages: {
                    Name: {
                        required: "Please enter name",
                    },
                    UserName: {
                        required: "Please enter user name",
                    },
                    Password: {
                        required: "Please enter password",
                    },
                    MobileNo: {
                        required: "Please enter mobile no",
                    },
                    Email: {
                        required: "Please enter email",
                    }
                }
            });

        });
    </script>
}