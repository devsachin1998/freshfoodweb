@model  Stock_Model

@if (Model != null)
{
    <table class="table table-striped table-bordered table-hover dataTables-example">
        <thead>
            <tr>
                <th>Weight</th>
                <th>Price</th>
            </tr>
        </thead>
        <tbody>

            @for (var j = 0; j < Model._subitemList.Count; j++)
                {

                @Html.HiddenFor(m => m._subitemList[j].SubItemID)
                @Html.HiddenFor(m => m._subitemList[j].StockID)
                <tr class="gradeX">

                    <td>
                        @Html.TextBoxFor(m => m._subitemList[j].Weight_UOM, new { @class = "form-control", @readonly = true })
                    </td>

                    <td>
                        @Html.TextBoxFor(m => m._subitemList[j].Price, new { @placeholder = "Enter Price", @class = "form-control" })
                    </td>

                </tr>
            }
        </tbody>
    </table>
}