
@model Offer_Model
@{
    ViewBag.Title = "OfferMaster";
    int count = 1;

}

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-lg-10">
        <h2>Offers</h2>
        <ol class="breadcrumb">
            <li>
                <a href="@Url.Action("Index", "Home")">Dashboard</a>
            </li>
            <li class="active">
                <strong>Manage Offer</strong>
            </li>
        </ol>
    </div>
    <div class="col-lg-2">
    </div>
</div>
<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>Add | Edit Offer</h5>
                </div>
                <div class="ibox-content">
                    @using (Html.BeginForm("SaveOffer", "Offer", FormMethod.Post, new { @id = "frmAddUpdate", @enctype = "multipart/form-data" }))
                    {
                        @Html.HiddenFor(m => m.OfferId)
                        <div class="form-group row">
                            <div class="col-sm-6">
                                @Html.Label("Offer Name") <b style="color:red"> *</b>
                                @Html.TextBoxFor(m => m.OfferName, new { @class = "form-control", @id = "OfferName", @name = "OfferName", @autocomplete = "off", @onkeyup = "return fnCheckOfferName()" })
                                <label id="OfferError" class="error">Entered Offer is already exist</label>
                            </div>
                            <div class="col-md-3" style="margin-top: 23px;">
                                <button type="submit" id="btnSubmit" class="btn btn-primary" onkeypress="return event.keyCode != 13;"><i class="fa fa-save"></i>&nbsp; Save</button>
                                &nbsp;&nbsp;
                                <a class="btn btn-white" href="@Url.Action("OfferMaster", "Offer")"><i class="fa fa-refresh"></i>&nbsp; Reset</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>Offer List</h5>
                </div>
                <div class="ibox-content">
                    <table class="table table-striped table-bordered table-hover dataTables-example">
                        <thead>
                            <tr>
                                <th width="5%">Sr.No</th>
                                <th>Offer Name</th>
                                <th class="text-center" width="10%">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null)
                            {
                                foreach (var item in Model._OfferList)
                                {

                                    <tr class="gradeX">
                                        <td>@count</td>
                                        <td>@item.OfferName</td>
                                        <td class="text-center">
                                            @if (item.IsActive.Equals("1"))
                                            {
                                                <span class="label label-primary" style="font-size:12px;background-color:#629607;">
                                                    <a style="color: #ffffff;" title="Active" onclick="ManageOffer(@item.OfferId, 0)">
                                                        Active
                                                    </a>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="label label-danger" style="font-size: 12px">
                                                    <a style="color: #ffffff;" title="InActive" onclick="ManageOffer(@item.OfferId, 1)">
                                                        InActive
                                                    </a>
                                                </span>
                                            }

                                        </td>
                                        <td class="text-center">
                                            <span class="label label-danger" style="font-size:12px;">
                                                <a title="Delete Offer" style="color: #ffffff;" href="#" onclick="fnDeleteOffer(@item.OfferId)">
                                                    <i class="fa fa-trash"></i>&nbsp; Delete
                                                </a>
                                            </span>

                                        </td>
                                    </tr>
                                    count++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
@section Styles {
    @Styles.Render("~/Content/plugins/dataTables/dataTablesStyles")
    @Styles.Render("~/plugins/sweetAlertStyles")
    @Styles.Render("~/plugins/dataPickerStyles")
    @Styles.Render("~/plugins/select2Styles")
}

@section Scripts {
    @Scripts.Render("~/plugins/dataTables")
    @Scripts.Render("~/plugins/sweetAlert")
    @Scripts.Render("~/plugins/validate")
    @Scripts.Render("~/plugins/dataPicker")
    @Scripts.Render("~/plugins/select2")

    <script type="text/javascript">
        $(document).ready(function () {

            $("#OfferError").hide();

            if ('@TempData["SuccessMessage"]' != '') {
                sweetAlert("Sucesss!!", '@TempData["SuccessMessage"]', "success");
            }
            if ('@TempData["ErrorMessage"]' != '') {
                sweetAlert("Error!!", '@TempData["ErrorMessage"]', "error");
            }

            $('.dataTables-example').DataTable({
                pageLength: 25,
                dom: '<"html5buttons"B>lTfgitp',
                buttons: [
                    { extend: 'copy' },
                    { extend: 'csv' },
                    { extend: 'excel', title: 'ExampleFile' },
                    { extend: 'pdf', title: 'ExampleFile' },
                    {
                        extend: 'print',
                        customize: function (win) {
                            $(win.document.body).addClass('white-bg');
                            $(win.document.body).css('font-size', '10px');

                            $(win.document.body).find('table')
                                .addClass('compact')
                                .css('font-size', 'inherit');
                        }
                    }
                ]
            });

            $("#frmAddUpdate").validate({
                rules: {
                    OfferName: {
                        required: true
                    }
                },
                messages: {
                    OfferName: {
                        required: "Please enter Offer name"
                    }
                }
            });


        });

        function fnCheckOfferName() {
            debugger;
            if ($("#OfferId").val() == "0") {
                var OfferName = $("#OfferName").val();
                var Date = $("#Date").val();
                $.ajax({
                    url: '@Url.Action("CheckOfferIsExist", "Offer")',
                    type: "GET",
                    dataType: "JSON",
                    data: { OfferName: OfferName 
                           , Date: Date },
                    success: function (data) {
                        if (data != '') {
                            $("#OfferError").show();
                            document.getElementById("btnSubmit").disabled = true;
                        } else {
                            $("#OfferError").hide();
                            document.getElementById("btnSubmit").disabled = false;
                        }
                    }
                });
            }
        }
    function ManageOffer(CatID, Status) {
            var action = "";
            debugger;
            if (Status=="0") {
                action = "Inactive";
            } else {
                action = "Active";
            }
            swal({
                title: "Are you sure?",
                text: "You want to " + action + " this Offer?",
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#DD6B55",
                confirmButtonText: "Yes, " + status + " it!",
                closeOnConfirm: false
            }, function (e) {
                if (e) {
                    $.ajax(
                    {
                        type: "Post",
                        datatype: "JSON",
                        url: "@Url.Action("ManageOffer", "Offer")",
                            data: { Off_Id: CatID,  Status: Status },
                        success: function (data) {
                            if (data != null) {
                                swal(data);
                                window.setTimeout(function () {
                                    location.reload();
                                }, 1000);
                            }
                        },
                        error: function (event, xhr, options, exc) {
                            swal("An error occured please try again !!");
                        }
                    });
                }
            });
    }







    function fnDeleteOffer(OfferId) {
            swal({
                title: "Are you sure?",
                text: "You want to delete this Offer?",
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#DD6B55",
                closeOnConfirm: false
            }, function (e) {
                if (e) {
                    $.ajax(
                        {
                            type: "GET",
                            url: '@Url.Action("DeleteOffer", "Offer")',
                            contentType: 'application/json; charset=utf-8',
                            data: { OfferId: OfferId },
                            dataType: "JSON",
                            success: function (data) {
                                swal(data);
                                window.setTimeout(function () {
                                    location.reload();
                                }, 1000);
                            },
                            error: function (event, xhr, options, exc) {
                                sweetAlert("Error!!", data, "error");
                            }
                        });
                }
            });
        }


        //function EditDetail(CategoryID, CategoryName, MobileNo) {
        //    $('.form-group').removeClass('has-success has-error');
        //    $('.help-block').remove();
        //    $('#frmAddUpdate')[0].reset();
        //    $('#frmAddUpdate').validate().resetForm();
        //    $("#CategoryID").val(CategoryID);
        //    $("#CategoryName").val(CategoryName);
        //    $("#MobileNo").val(MobileNo);
        //}

    </script>
}