@model Offer_Model
@{
    ViewBag.Title = "AddOffer";
    int count = 1;
}

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-lg-10">
        <h2>Offers</h2>
        <ol class="breadcrumb">
            <li>
                <a href="@Url.Action("Index", "Home")">Dashboard</a>
            </li>
            <li class="active">
                <strong>Add Offer</strong>
            </li>
        </ol>
    </div>
    <div class="col-lg-2">
    </div>
</div>
<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>Add Offer</h5>

                </div>
                <div class="ibox-content">
                    @using (Html.BeginForm("SaveOffers", "Offer", FormMethod.Post, new { @id = "frmAddUpdate", @enctype = "multipart/form-data" }))
                    {
                        @Html.HiddenFor(m => m.OfferId)
                        <div class="form-group row">
                            <div class="col-sm-5">
                                @Html.Label("Offer Name")
                                @Html.TextBoxFor(m => m.OfferName, new {@id= "OffName", @class = "form-control" })
                            </div>
                            <div class="col-sm-3">
                                @Html.Label("Type")
                                @Html.DropDownListFor(m => m.Type, CommonHelper.GetOffer(), new { @class = "form-control" })
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-sm-3">
                                @Html.Label("Minimum Amount")
                                @Html.TextBoxFor(m => m.MinimumAmont, new {@id= "MinAmount", @class = "form-control"  })
                            </div>
                            <div class="col-sm-3">
                                @Html.Label("Applicable Cashback On")
                                @Html.DropDownListFor(m => m.ApplicableCashBack, CommonHelper.AppCashback(), new {@id="AppAMount" ,@class = "form-control" })

                            </div>

                            <div class="col-sm-3">
                                @Html.Label(" % Or Value")
                                @Html.TextBoxFor(m => m.Amount, new { @class = "form-control" ,@id= "Amot", @onkeyup = "fncalPrice ()" })
                            </div>

                        </div>

                        <div class="form-group row">
                            <div class="col-sm-3">
                                @Html.Label("Total Cashback") <b style="color:red"> *</b>
                                @Html.TextBoxFor(m => m.TotalCashBack, new { @id = "total" ,@class = "form-control"})
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-sm-7 ">
                                <button type="submit" id="btnSubmit" class="btn btn-primary" onkeypress="return event.keyCode != 13;"><i class="fa fa-save"></i>&nbsp; Save</button>&nbsp;&nbsp;
                                &nbsp;&nbsp;
                                <a class="btn btn-white" href="@Url.Action("AddOffer", "Offer")"><i class="fa fa-refresh"></i>&nbsp; Reset</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>


    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>Offer List</h5>
                </div>
                <div class="ibox-content">
                    <table class="table table-striped table-bordered table-hover dataTables-example">
                        <thead>
                            <tr>
                                <th>Sr.No</th>
                                <th>Offer Name</th>
                                <th>Type</th>
                                <th>Minimum  Amount</th>
                                <th>Applicable Amount</th>
                                <th>Total Cashback</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model != null)
                            {
                                foreach (var item in Model._OfferDetails)
                                {

                                    <tr class="gradeX">
                                        <td>@count</td>
                                        <td>@item.OfferName</td>
                                        <td>@item.Type</td>
                                        <td>@item.MinimumAmont</td>
                                        <td>@item.ApplicableCashBack</td>
                                        <td>@item.TotalCashBack</td>
                                        <td class="text-center">
                                            @if (item.IsActive.Equals("1"))
                                            {
                                                <span class="label label-primary" style="font-size:12px;background-color:#629607;">
                                                    <a style="color: #ffffff;" title="Active" onclick="FnManageOfferData(@item.Id, 0)">
                                                        Active
                                                    </a>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="label label-danger" style="font-size: 12px">
                                                    <a style="color: #ffffff;" title="InActive" onclick="FnManageOfferData(@item.Id, 1)">
                                                        InActive
                                                    </a>
                                                </span>
                                            }

                                        </td>
                                        <td class="text-center">
                                            <span class="label label-danger" style="font-size:12px;">
                                                <a title="Delete Offer" style="color: #ffffff;" href="#" onclick="FnDeleteOfferData(@item.Id)">
                                                    <i class="fa fa-trash"></i>&nbsp; Delete
                                                </a>
                                            </span>

                                        </td>
                                    </tr>
                                    count++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    @Styles.Render("~/Content/plugins/dataTables/dataTablesStyles")
    @Styles.Render("~/plugins/sweetAlertStyles")
    @Styles.Render("~/plugins/dataPickerStyles")
    @Styles.Render("~/plugins/select2Styles")
}

@section Scripts {
    @Scripts.Render("~/plugins/dataTables")
    @Scripts.Render("~/plugins/sweetAlert")
    @Scripts.Render("~/plugins/validate")
    @Scripts.Render("~/plugins/dataPicker")
    @Scripts.Render("~/plugins/select2")

<script type="text/javascript">
        $(document).ready(function () {
            debugger;
            if ('@TempData["SuccessMessage"]' != '') {
                sweetAlert("Sucesss!!", '@TempData["SuccessMessage"]', "success");
            }
            if ('@TempData["ErrorMessage"]' != '') {
                sweetAlert("Error!!", '@TempData["ErrorMessage"]', "error");
            }

            $('.dataTables-example').DataTable({
                pageLength: 25,
                dom: '<"html5buttons"B>lTfgitp',
                buttons: [
                    { extend: 'copy' },
                    { extend: 'csv' },
                    { extend: 'excel', title: 'ExampleFile' },
                    { extend: 'pdf', title: 'ExampleFile' },
                    {
                        extend: 'print',
                        customize: function (win) {
                            $(win.document.body).addClass('white-bg');
                            $(win.document.body).css('font-size', '10px');

                            $(win.document.body).find('table')
                                .addClass('compact')
                                .css('font-size', 'inherit');
                        }
                    }
                ]
            });
        });




    $("#frmAddUpdate").validate({
        rules: {
            MinimumAmont: {
                required: true,
            },
            ApplicableCashBack: {
                required: true
            },
            Amount: {
                required: true,
            }
        },
        messages: {
            MinimumAmont: {
                required: "Please enter Minimum Amount",
            },
            ApplicableCashBack: {
                required: "Please select ApplicableCashback",
            },
            Amount: {
                required: "Please enter Amount",
            }
        }
    });







        function FnManageOfferData(OffId, Status) {
            var action = "";
            debugger;
            if (Status == true) {
                action = "add";
            } else {
                action = "remove";
            }
            swal({
                title: "Are you sure?",
                text: "You want to " + action + " this item Offer?",
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#DD6B55",
                confirmButtonText: "Yes, " + status + " it!",
                closeOnConfirm: false
            }, function (e) {
                if (e) {
                    $.ajax(
                    {
                        type: "Post",
                        datatype: "JSON",
                        url: "@Url.Action("ManageOfferData", "Offer")",
                            data: { OffId: OffId,  Status: Status },
                        success: function (data) {
                            if (data != null) {
                                swal(data);
                                window.setTimeout(function () {
                                    location.reload();
                                }, 1000);
                            }
                        },
                        error: function (event, xhr, options, exc) {
                            swal("An error occured please try again !!");
                        }
                    });
                }
            });
        }


        function FnDeleteOfferData(Id) {
            swal({
                title: "Are you sure?",
                text: "You want to delete this Offer?",
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#DD6B55",
                closeOnConfirm: false
            }, function (e) {
                if (e) {
                    $.ajax(
                        {
                            type: "GET",
                            url: '@Url.Action("DeleteOfferData", "Offer")',
                            contentType: 'application/json; charset=utf-8',
                            data: { Id: Id },
                            dataType: "JSON",
                            success: function (data) {
                                swal(data);
                                window.setTimeout(function () {
                                    location.reload();
                                }, 1000);
                            },
                            error: function (event, xhr, options, exc) {
                                sweetAlert("Error!!", data, "error");
                            }
                        });
                }
            });
        }


        function fncalPrice()
    {
            var MinimumAmont = document.getElementById('MinAmount').value;
            var ApplicableCashBack = document.getElementById('AppAMount').value;
            var Amount = document.getElementById('Amot').value;
            $("#total").prop("readonly", true);
            $.ajax(
                {
                 type: "GET",
                 url: '@Url.Action("CalculateOfferPrice", "Offer")',
                contentType: 'application/json; charset=utf-8',
                data: {
                    MinimumAmont: MinimumAmont,
                    ApplicableCashBack: ApplicableCashBack,
                    Amount: Amount,
                    //TotalCashBack: TotalCashBack
                    },
                    dataType: "JSON",
                    success: function (data) {
                        document.getElementById("total").value = data.toFixed(2);
                        parseFloat(data).toFixed(2);
                        },
                    error: function (event, xhr, options, exc) {
                    }
                });
    }
</script>
}