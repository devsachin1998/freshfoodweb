@model List<Admin.Models.Stock_SubItem>

@{
    ViewBag.Title = "Stock List";
}

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-lg-10">
        <h2>Stock List</h2>
        <ol class="breadcrumb">
            <li>
                <a href="@Url.Action("Index", "Home")">Dashboard</a>
            </li>
            <li class="active">
                <strong>Stock List</strong>
            </li>
        </ol>
    </div>
</div>

<div class="wrapper wrapper-content">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>Stock List</h5>
                    <div class="ibox-tools">
                        <a href="@Url.Action("ManageStock", "Store")"
                           class="btn btn-primary">
                            <i class="fa fa-plus"></i> Add Stock
                        </a>
                    </div>
                </div>

                <div class="ibox-content">
                    <div class="table-responsive">
                        <table id="stockTable"
                               class="table table-striped table-bordered table-hover"
                               style="width:100%; min-width:850px;">
                            <thead>
                                <tr>
                                    <th>Sr.No</th>
                                    <th>Item Name</th>
                                    <th>Weight</th>
                                    <th>Selling Price</th>
                                    <th>In Stock</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    @Styles.Render("~/plugins/sweetAlertStyles")
    @Styles.Render("~/Content/plugins/dataTables/dataTablesStyles")

    <style>
        .table-responsive {
            width: 100%;
            overflow-x: auto !important;
            -webkit-overflow-scrolling: touch;
        }

        #stockTable th,
        #stockTable td {
            vertical-align: middle !important;
            white-space: nowrap;
        }

        #stockTable .label {
            display: inline-block;
            padding: 6px 9px;
            cursor: pointer;
        }

        #stockTable .action-link {
            display: inline-block;
            margin: 2px;
            color: #fff;
            padding: 6px 9px;
            border-radius: 3px;
        }

        #stockTable .edit-link {
            background: #1ab394;
        }

        #stockTable .delete-link {
            background: #ed5565;
        }

        @@media (max-width: 767px) {
            #stockTable {
                min-width: 850px !important;
            }

                #stockTable th,
                #stockTable td {
                    padding: 8px;
                }
        }
    </style>
}

@section Scripts {
    @Scripts.Render("~/plugins/sweetAlert")
    @Scripts.Render("~/plugins/dataTables")

    <script>
        $(function () {
            // Edit URL ek baar banao, har row pe Razor/string kaam na ho.
            var manageStockUrl = '@Url.Action("ManageStock", "Store")';

            // Escape database values before displaying them as HTML.
            // Plain string replace: har cell pe naya DOM element nahi banta.
            var htmlMap = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
            function textRenderer(value) {
                return (value == null ? '' : String(value))
                    .replace(/[&<>"']/g, function (c) { return htmlMap[c]; });
            }

            // =====================================
            // SERVER-SIDE PAGING
            // Har page pe sirf 25 rows server se aati hain.
            // =====================================
            var table = $('#stockTable').DataTable({
                processing: true,
                serverSide: true,
                searchDelay: 500,
                pageLength: 25,
                lengthMenu: [
                    [10, 25, 50, 100],
                    [10, 25, 50, 100]
                ],
                autoWidth: false,
                order: [[1, 'asc']],

                ajax: {
                    url: '@Url.Action("StockListData", "Store")',
                    type: 'GET',
                    cache: false,
                    // Sirf zaroori parameters bhejo (choti URL)
                    data: function (d) {
                        return {
                            draw: d.draw,
                            start: d.start,
                            length: d.length,
                            search: (d.search && d.search.value) || '',
                            orderColumn: d.order && d.order.length ? d.order[0].column : 1,
                            orderDir: d.order && d.order.length ? d.order[0].dir : 'asc'
                        };
                    },
                    error: function (xhr) {
                        console.error('Stock list loading failed:', xhr.responseText);
                        $('#stockTable_processing').hide();
                        swal('Error', 'Unable to load stock list.', 'error');
                    }
                },

                dom: '<"html5buttons"B>lTfgitp',

                // Note: export sirf current page (25 rows) ka hota hai.
                buttons: [
                    { extend: 'copy', title: 'Stock List', exportOptions: { columns: [1, 2, 3, 4] } },
                    { extend: 'csv', title: 'Stock List', exportOptions: { columns: [1, 2, 3, 4] } },
                    { extend: 'excel', title: 'Stock List', exportOptions: { columns: [1, 2, 3, 4] } },
                    {
                        extend: 'print',
                        title: 'Stock List',
                        exportOptions: { columns: [1, 2, 3, 4] },
                        customize: function (win) {
                            $(win.document.body)
                                .addClass('white-bg')
                                .css('font-size', '10px');

                            $(win.document.body).find('table')
                                .addClass('compact')
                                .css('font-size', 'inherit');
                        }
                    }
                ],

                columns: [
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        render: function (data, type, row, meta) {
                            return meta.settings._iDisplayStart + meta.row + 1;
                        }
                    },
                    {
                        data: 'ItemName',
                        render: textRenderer
                    },
                    {
                        data: 'Weight',
                        render: function (data, type, row) {
                            var w = $.trim(row.Weight || '');
                            var u = $.trim(row.UOMName || '');

                            // Weight mein unit pehle se ho ("500 gms") to dobara mat jodo
                            if (u && w.toLowerCase().slice(-u.length) !== u.toLowerCase()) {
                                w += ' ' + u;
                            }

                            return textRenderer(w);
                        }
                    },
                    {
                        data: 'Price',
                        render: textRenderer
                    },
                    {
                        data: 'InStock',
                        orderable: false,
                        searchable: false,
                        render: function (data, type, row) {
                            var status = row.InStock === true || row.InStock === 'true';

                            if (type !== 'display') {
                                return status ? 'In Stock' : 'Out of Stock';
                            }

                            return '<a href="#" class="label ' +
                                (status ? 'label-primary' : 'label-danger') +
                                ' stock-status" data-id="' + row.StockID +
                                '" data-status="' + (!status) + '">' +
                                (status ? 'In Stock' : 'Out of Stock') +
                                '</a>';
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        className: 'text-center',
                        render: function (data, type, row) {
                            var editUrl = manageStockUrl +
                                '?MainID=' + encodeURIComponent(row.MainID);

                            return '<a class="action-link edit-link" href="' +
                                editUrl + '" title="Edit Stock">' +
                                '<i class="fa fa-pencil"></i> Edit</a> ' +
                                '<a href="#" class="action-link delete-link" ' +
                                'data-id="' + row.StockID + '" ' +
                                'title="Delete Stock">' +
                                '<i class="fa fa-trash"></i> Delete</a>';
                        }
                    }
                ],

                // Browser search box mein saved username / email
                // khud na bhar de (warna "No matching" aata hai).
                initComplete: function () {
                    var api = this.api();
                    var $search = $('#stockTable_filter input');

                    $search.attr({
                        autocomplete: 'off',
                        name: 'stock_search_' + Date.now(),
                        readonly: 'readonly'
                    }).on('focus', function () {
                        $(this).removeAttr('readonly');
                    });

                    var userTyped = false;
                    $search.on('keydown paste', function () { userTyped = true; });

                    setTimeout(function () {
                        if (!userTyped && $search.val() !== '') {
                            $search.val('');
                            api.search('').draw();
                        }
                    }, 1000);
                },

                language: {
                    processing: 'Loading stock...',
                    loadingRecords: '<i class="fa fa-spinner fa-spin"></i> Loading stock...',
                    emptyTable: 'No stock records found.',
                    zeroRecords: 'No matching stock records found.'
                }
            });

            // Common AJAX + confirm helper (status update aur delete dono ke liye).
            function confirmAndPost(options) {
                swal({
                    title: 'Are you sure?',
                    text: options.confirmText,
                    type: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#DD6B55',
                    confirmButtonText: options.confirmButton,
                    cancelButtonText: 'Cancel',
                    closeOnConfirm: false
                }, function (confirmed) {
                    if (!confirmed) return;

                    $.ajax({
                        url: options.url,
                        type: 'POST',
                        data: options.data,
                        success: function (response) {
                            if (response && response.success) {
                                swal({
                                    title: options.successTitle,
                                    text: options.successText,
                                    type: 'success'
                                }, function () {
                                    table.ajax.reload(null, false);
                                });
                            } else {
                                swal('Error',
                                    response && response.message
                                        ? response.message
                                        : options.failText,
                                    'error');
                            }
                        },
                        error: function () {
                            swal('Error', options.errorText, 'error');
                        }
                    });
                });
            }

            // Update In Stock / Out of Stock.
            $('#stockTable').on('click', '.stock-status', function (e) {
                e.preventDefault();

                var link = $(this);
                var stockID = parseInt(link.attr('data-id'), 10);
                var status = link.attr('data-status') === 'true';

                if (!stockID) return;

                confirmAndPost({
                    url: manageStockUrl,
                    data: { StockID: stockID, Status: status },
                    confirmText: 'Do you want to ' + (status ? 'add' : 'remove') + ' this stock?',
                    confirmButton: 'Yes',
                    successTitle: 'Updated!',
                    successText: 'Stock status updated successfully.',
                    failText: 'Unable to update stock.',
                    errorText: 'Something went wrong while updating stock.'
                });
            });

            // Delete stock.
            $('#stockTable').on('click', '.delete-link', function (e) {
                e.preventDefault();

                var stockID = parseInt($(this).attr('data-id'), 10);

                if (!stockID) return;

                confirmAndPost({
                    url: '@Url.Action("DeleteStock", "Store")',
                    data: { StockID: stockID },
                    confirmText: 'You want to delete this stock?',
                    confirmButton: 'Yes, delete it!',
                    successTitle: 'Deleted!',
                    successText: 'Stock deleted successfully.',
                    failText: 'Unable to delete stock.',
                    errorText: 'Something went wrong while deleting stock.'
                });
            });
        });
    </script>
}