@{
    ViewBag.Title = "Order Summary";
}

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-lg-10">
        <h2>Reports</h2>
        <ol class="breadcrumb">
            <li>
                <a href="@Url.Action("Index", "Home")">Dashboard</a>
            </li>
            <li class="active">
                <strong>Order Payment</strong>
            </li>
        </ol>
    </div>
    <div class="col-lg-2">
    </div>
</div>
<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>Order Payment</h5>
                </div>
                <div class="ibox-content">
                    @using (Html.BeginForm("OrderSummary", "Report", FormMethod.Get, new { @id = "frmAddUpdate", @enctype = "multipart/form-data" }))
                    {
                        <div class="row">
                            <div class="col-md-3">
                                @Html.Label("Select Date")  <b style="color:red"> *</b>
                                <div class="form-group" id="data_1">
                                    <div class="input-group date">
                                        <span class="input-group-addon"><i class="fa fa-calendar"></i></span>@Html.TextBox("ReportDate", null, new { @class = "form-control", @autocomplete = "off" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3" style="margin-top: 22px;">
                                <button type="submit" id="btnSubmit" class="btn btn-primary">Search</button>&nbsp;&nbsp;
                                <a class="btn btn-white" href="@Url.Action("OrderSummary", "Report")">Reset</a>
                            </div>
                        </div>
                        <hr />
                        <table class="table table-striped table-bordered table-hover dataTables-example">
                            <thead>
                                <tr>
                                    <th>Order No</th>
                                    <th class="text-right">Customer Name</th>
                                    <th width="20%" class="text-right">Recevied Amount</th>
                                    <th class="text-center" width="15%"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null)
                                {
                                    foreach (var item in Model._OrderDetails)
                                    {
                                        <tr class="gradeX">
                                            <td><a title="View Order" href="@Url.Action("OrderDetail","ManageOrder",new { OrderID = item.OrderID })"><b>@item.OrderNo</b></a></td>
                                            <td class="text-right">&nbsp;@item.CustomerName</td>
                                            <td class="text-right"><i class="fa fa-inr" aria-hidden="true"></i>&nbsp;@item.ReceviedAmount</td>

                                            <td class="text-center">
                                                <span class="label label-success" style="font-size:12px;">
                                                    <a title="Order Summary" style="color: #ffffff;" href="@Url.Content(item.Invoice)" target="_blank">
                                                        <i class="fa fa-file"></i>&nbsp; Invoice
                                                    </a>
                                                </span>
                                            </td>
                                        </tr>
                                    }

                                }
                            </tbody>
                            <th width="20%" class="text-right">Total Amount</th>
                            <th width="20%" class="text-right"></th>
                            <th width="20%" class="text-right"><i class="fa fa-inr" aria-hidden="true"></i>&nbsp;@Model.ItemTotal_UOM</th>
                            <th width="20%" class="text-right"></th>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    @Styles.Render("~/plugins/sweetAlertStyles")
    @Styles.Render("~/plugins/dateRangeStyles")
    @Styles.Render("~/plugins/dataPickerStyles")
    @Styles.Render("~/Content/plugins/iCheck/iCheckStyles")
    @Styles.Render("~/plugins/awesomeCheckboxStyles")
    @Styles.Render("~/plugins/select2Styles")
    @Styles.Render("~/plugins/footableStyles")
    @Styles.Render("~/Content/plugins/dataTables/dataTablesStyles")
}
@section Scripts{
    @Scripts.Render("~/plugins/sweetAlert")
    @Scripts.Render("~/plugins/dateRange")
    @Scripts.Render("~/plugins/dataPicker")
    @Scripts.Render("~/plugins/iCheck")
    @Scripts.Render("~/plugins/select2")
    @Scripts.Render("~/plugins/validate")
    @Scripts.Render("~/plugins/footable")
    @Scripts.Render("~/plugins/dataTables")

    <script type="text/javascript">
        $(document).ready(function () {

            if ('@TempData["SuccessMessage"]' != '') {
                sweetAlert("Sucesss!!", '@TempData["SuccessMessage"]', "success");
            }
            if ('@TempData["ErrorMessage"]' != '') {
                sweetAlert("Error!!", '@TempData["ErrorMessage"]', "error");
            }

            $('#data_1 .input-group.date').datepicker({
                todayBtn: "linked",
                keyboardNavigation: false,
                forceParse: false,
                calendarWeeks: true,
                autoclose: true,
                format: "dd/mm/yyyy"
            });

            $("#frmAddUpdate").validate({
                rules: {
                    ReportDate: {
                        required: true,
                    },
                    CategoryID: {
                        required: true
                    }
                },
                messages: {
                    ReportDate: {
                        required: "Please enter date",
                    },
                    CategoryID: {
                        required: "Please select category",
                    }
                }
            });

            $('.dataTables-example').DataTable({
                "ordering": false,
                pageLength: 25,
                dom: '<"html5buttons"B>lTfgitp',
                buttons: [
                    { extend: 'copy' },
                    { extend: 'csv' },
                    { extend: 'excel', title: 'ExampleFile' },
                    { extend: 'pdf', title: 'ExampleFile' },
                    {
                        extend: 'print',
                        customize: function (win) {
                            $(win.document.body).addClass('white-bg');
                            $(win.document.body).css('font-size', '10px');

                            $(win.document.body).find('table')
                                .addClass('compact')
                                .css('font-size', 'inherit');
                        }
                    }
                ]
            });
        });

    </script>
}